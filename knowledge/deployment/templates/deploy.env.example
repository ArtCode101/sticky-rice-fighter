# Configuration of the local deploy, the one the definition of done measures.
#
# Copy to `.env` in the config repository's local-deploy/ directory. Git-ignored, never
# committed. local/deploy.sh and preflight/done-check.sh both read it.
#
# The develop zone has its own values in local/.env and stays up during a deploy, so
# nothing here may repeat its container names or host ports.

# Names the containers. The compose project in local/compose.yml has the same name.
WORKSPACE_NAME=my-workspace-deploy

# --- Host ports. The develop zone uses the same numbers without the leading 2. ---
NGINX_PORT=28000
MCP_PORT=28100
POSTGRES_PORT=25432
REDIS_PORT=26379
KAFKA_PORT=29094

# --- Datastores ---
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
KAFKA_CLUSTER_ID=my-workspace-deploy-cluster-1

# --- Image tags, per knowledge/versioning/AGENTS.md. One per repository. ---
FRONTEND_IMAGE_TAG=latest
MCP_IMAGE_TAG=latest
