# Local environment configuration for this workspace.
#
# Copy to `.env` next to local-env.sh. Git-ignored, never committed.
# The authoritative copy of these values lives in the workspace's config
# repository under `local/`.

# Required. Names the containers and the compose project, so this workspace's
# local environment never collides with another one on the same machine.
WORKSPACE_NAME=my-workspace

# --- PostgreSQL ---
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# --- Kafka ---
KAFKA_PORT=9094
KAFKA_CLUSTER_ID=my-workspace-cluster-1

# When a second workspace runs at the same time, give it different port values
# here. Compose cannot compute an offset on its own.
