{
  "name": "mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server over this workspace's backend API. Generated from the OpenAPI documents in the registry repository.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "node --experimental-strip-types src/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "@types/node": "26.6.3"
  }
}
