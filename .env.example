# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored and never committed.

# Absolute path to the workspace this framework operates on.
# The framework reads this repository and writes only inside WORKSPACE_PATH.
# Required. No default.
WORKSPACE_PATH=/absolute/path/to/your/workspace

# Note: the framework operating mode (edit / working) is NOT set here.
# It lives in `flag.yml` at the repository root, which is the single source of
# truth for that switch.
